@model project6.Models.products

@{
    ViewBag.Title = "Product Details";
}


@{ 
    Layout = null;
}


<h2>Product Details</h2>

<table border="1" cellpadding="10" cellspacing="0" 
       style="background-color: #EEEAD7; color: #6D0808; ">
    <tr>
        <th>ID</th>
        <td>@Model.id</td>
    </tr>

    <tr>
        <th>Name</th>
        <td>@Model.name</td>
    </tr>

    <tr>
        <th>Description</th>
        <td>@Model.description</td>
    </tr>

    <tr>
        <th>Price</th>
        <td>₹@Model.price</td>
    </tr>

    <tr>
        <th>Quantity</th>
        <td>@Model.quantity</td>
    </tr>

    <tr>
        <th>Category</th>
        <td>@Model.category</td>
    </tr>

    <tr>
        <th>Image</th>
        <td>
            <img src="@Model.imageurl"
                 alt="@Model.name"
                 style="width:150px;" />
        </td>
    </tr>
</table>

<br />

@Html.ActionLink("Back to Product Catalog", "Index", "Product")